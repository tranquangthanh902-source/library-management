<%- include('../partials/header') %><div class="admin-layout"><%- include('../partials/sidebar') %><main class="admin-main">
<div class="topbar"><div><span class="muted">Sách</span><h1><%= book.title %></h1></div><a class="btn primary" href="/admin/books/edit/<%= book.id %>">Sửa sách</a></div>
<div class="detail-grid"><div class="panel"><h2>Thông tin sách</h2><p><b>ISBN:</b> <%= book.isbn %></p><p><b>Tác giả:</b> <%= book.author %></p><p><b>Nhà xuất bản:</b> <%= book.publisher||'-' %></p><p><b>Năm:</b> <%= book.year||'-' %></p><p><b>Danh mục:</b> <%= book.category||'-' %></p><p><b>Số lượng:</b> <%= book.quantity %> | <b>Còn:</b> <%= book.available %></p><p><b>Mô tả:</b> <%= book.description||'Không có' %></p></div>
<div class="panel qr-panel"><h2>QR tra cứu</h2><img class="qr-code" src="<%= qr %>" alt="QR tra cứu sách"><p class="muted">Quét mã để mở trang tra cứu theo ISBN.</p><button class="btn light-dark" onclick="window.print()">In chi tiết</button></div></div><div class="panel"><h2>Lịch sử mượn</h2><table><thead><tr><th>Bạn đọc</th><th>Mượn</th><th>Trả</th><th>Trạng thái</th></tr></thead><tbody><% history.forEach(h=>{ %><tr><td><%= h.reader %></td><td><%= h.borrow_date %></td><td><%= h.return_date||'-' %></td><td><%= h.status %></td></tr><% }) %></tbody></table></div>
</main></div><%- include('../partials/footer') %>
