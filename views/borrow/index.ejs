<%- include('../partials/header') %><div class="admin-layout"><%- include('../partials/sidebar') %><main class="admin-main">
<div class="topbar"><div><span class="muted">Thư viện</span><h1>Mượn / Trả sách</h1></div><a class="btn primary" href="/admin/borrow/create">Tạo phiếu mượn</a></div>
<div class="filters"><a class="<%= !status?'active':'' %>" href="/admin/borrow">Tất cả</a><a class="<%= status==='Đang mượn'?'active':'' %>" href="/admin/borrow?status=Đang%20mượn">Đang mượn</a><a class="<%= status==='Đã trả'?'active':'' %>" href="/admin/borrow?status=Đã%20trả">Đã trả</a></div>
<div class="panel"><table><thead><tr><th>ID</th><th>Bạn đọc</th><th>Sách</th><th>Ngày mượn</th><th>Hạn trả</th><th>Trả</th><th>Trạng thái</th><th></th></tr></thead><tbody>
<% records.forEach(r=>{ const overdue=r.status==='Đang mượn' && new Date(r.due_date)<new Date(new Date().toISOString().slice(0,10)); %><tr class="<%= overdue?'overdue':'' %>"><td>#<%= r.id %></td><td><%= r.reader %></td><td><%= r.book %></td><td><%= r.borrow_date %></td><td><%= r.due_date %></td><td><%= r.return_date||'-' %></td><td><span class="badge <%= r.status==='Đã trả'?'ok':(overdue?'no':'warn') %>"><%= overdue?'Quá hạn':r.status %></span></td><td><% if(r.status==='Đang mượn'){ %><form method="post" action="/admin/borrow/return/<%= r.id %>"><button class="btn small">Trả sách</button></form><% } %></td></tr><% }) %>
</tbody></table></div></main></div><%- include('../partials/footer') %>
